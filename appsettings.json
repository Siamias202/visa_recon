{
    "DatabaseProvider": "mysql",
    "ConnectionStrings": {
        "mysql": "Server=localhost;Port=3306;Database=visa_recon;User ID=root;Password=;SslMode=None;AllowLoadLocalInfile=True;"
    },

    "Logging": {
        "EnableConsole": true
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning",
                "Ekyc.Onboarding.API.Infrastructure.HttpClientService": "Information"
            }
        }
    },

    "FileStorage": {
        "Provider": "Ftp",
        "Local": {
            "RootPath": "_files",
            "BasePath": "",
            "CreateFoldersIfMissing": true,
            "OverwriteExisting": true
        },
        "Encryption": {
            "Enabled": false,
            "Key": ""
        }
    },

    "AllowedHosts": "*"
}
